{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Trim",
  "mainBinaryName": "Trim",
  "version": "3.0.0",
  "identifier": "io.github.espentruls.trim",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Trim — Filament Calibration",
        "width": 1100,
        "height": 800,
        "minWidth": 700,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "espentruls",
    "copyright": "AGPL-3.0-only. A fork of PerfectFit by Aaron Taylor. Formerly PerfectFit X2D.",
    "shortDescription": "Filament calibration for single-, dual- and multi-nozzle printers",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
